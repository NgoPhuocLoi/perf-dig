{
  "uid": "orders-latency",
  "title": "/orders latency",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Mean latency (_sum / _count)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "1000 * sum(rate(http_server_requests_seconds_sum{uri=\"/orders\"}[1m])) / sum(rate(http_server_requests_seconds_count{uri=\"/orders\"}[1m]))",
          "legendFormat": "mean"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p99 latency (_bucket)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "1000 * histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/orders\"}[1m])))",
          "legendFormat": "p99"
        }
      ]
    }
  ]
}
